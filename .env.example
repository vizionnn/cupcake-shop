# Configurações do Supabase para o projeto Nuvem de Açúcar
# Obtenha essas chaves em: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Opcional (para operações administrativas que ignoram RLS no servidor)
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Better Auth (Opcional - para futura criação de contas e login)
# Obtenha DATABASE_URL em: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres
BETTER_AUTH_SECRET=uma-chave-secreta-forte-com-mais-de-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

